[layer_names]

2d_physics/layer_1="Wall"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="Player Weapon"
2d_physics/layer_5="Enemy Weapon"
2d_physics/layer_6="Item"
2d_physics/layer_7="Door"
2d_physics/layer_8="Player Interact"
2d_physics/layer_9="Pomegranate"
2d_physics/layer_10="Obstacle"
2d_physics/layer_11="Pomegranate Hitbox"
2d_physics/layer_12="Slow Liquid"
2d_physics/layer_13="Damage Liquid"
2d_physics/layer_14="Slippery Liquid"
2d_physics/layer_15="Shadow"
2d_physics/layer_16="Mirage Clone"
2d_physics/canvas_textures/default_texture_filter=1

[physics]

2d/solver/solver_iterations=8

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_repeat=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
