; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Seedovia"
run/main_scene="uid://cah3yq8uvftep"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=500
config/icon="res://icon.svg"
config/macos_native_icon="res://icon.icns"
config/windows_native_icon="res://icon.ico"

[audio]

buses/default_bus_layout="res://Resources/Audio/audio_bus_layout.tres"

[autoload]

PlayerInventory="*res://Scripts/Inventory/player_inventory.gd"
PlayerEquipment="*res://Scripts/Items/player_equipment.gd"
PlayerSeeds="*res://Scripts/Seeds/player_seeds.gd"
Global="*res://Scripts/Global/global.gd"
Pool="*res://Scripts/Items/pool.gd"
LevelList="*res://Scripts/Level/level_list.gd"
PlayerPassives="*res://Scripts/Passives/Data/player_passives.gd"
PlayerStatStorage="*res://Scripts/Player/player_stat_storage.gd"
Targets="*res://Scripts/Global/targets.gd"
PlayerCharacter="*res://Scripts/Player/player_character.gd"
SfxDeconflicter="*res://Scripts/Utils/sfx_deconflicter.gd"
SteamIntegration="*res://Scripts/Utils/steam_integration.gd"
ItemEffects="*res://Scripts/Items/item_effects.gd"
ItemCheck="*res://Scripts/Level/item_check.gd"
SelectionSaveData="*res://Scripts/Save Data/selection_save_data.gd"
SignalBus="*res://Scripts/Utils/signal_bus.gd"
Game="*res://Scenes/Utils/Game.tscn"
GlobalValues="*res://Scripts/Global/global_values.gd"
SeedManager="*res://Scripts/Global/seed_manager.gd"

[debug]

gdscript/warnings/unused_parameter=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"
window/vsync/vsync_mode=0
mouse_cursor/custom_image="res://Sprites/UI/Cursor.png"
mouse_cursor/custom_image_hotspot=Vector2(16, 16)

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/slidergamepad/plugin.cfg")

[file_customization]

folder_colors={
"res://Audio/": "red",
"res://Fonts/": "gray",
"res://Materials/": "orange",
"res://Resources/": "green",
"res://Scenes/": "pink",
"res://Scripts/": "blue",
"res://Shaders/": "purple",
"res://Sprites/": "yellow"
}

[global_group]

"Weapon to be Destroyed"=""

