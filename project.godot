; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Roguelike"
run/main_scene="res://Scenes/Levels/Special/Starting Room.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")

[autoload]

PlayerInventory="*res://Scripts/Inventory/player_inventory.gd"
PlayerEquipment="*res://Scripts/Items/player_equipment.gd"
PlayerSeeds="*res://Scripts/Seeds/player_seeds.gd"
Global="*res://Scripts/Global/global.gd"
Pool="*res://Scripts/Items/pool.gd"
LevelList="*res://Scripts/Level/level_list.gd"
PlayerPassives="*res://Scripts/Passives/Data/player_passives.gd"
PlayerStatStorage="*res://Scripts/Player/player_stat_storage.gd"

[debug]

gdscript/warnings/unused_parameter=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

